NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:devpass@localhost:5432/loans
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
RABBITMQ_URL=amqp://guest:guest@localhost:5672
LOG_LEVEL=info

# Comma-separated exact browser origins. Required explicitly in production.
CORS_ORIGINS=http://localhost:5173

# Set to the exact number of trusted reverse proxies in front of Express.
TRUST_PROXY_HOPS=0

# Defaults to true outside production and false in production.
API_DOCS_ENABLED=true
FORCE_SCORING_FAILURE=false
